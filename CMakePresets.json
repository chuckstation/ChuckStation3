{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (SDL, Release)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_USER_BUILD": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (SDL, full logs)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qt",
      "displayName": "Qt6 desktop frontend",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_USER_BUILD": "ON",
        "ENABLE_QT_BUILD": "ON"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "ENABLE_USER_BUILD": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (experimental)",
      "description": "Cross-compile for Android arm64. Requires ANDROID_NDK_HOME to be set. Normally invoked by Gradle; this preset is for manual builds.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_shared",
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$env{ANDROID_NDK_HOME}",
        "rhs": ""
      }
    },
    {
      "name": "tests",
      "displayName": "Build with tests enabled",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",        "configurePreset": "default" },
    { "name": "debug",          "configurePreset": "debug" },
    { "name": "qt",             "configurePreset": "qt" },
    { "name": "macos-arm64",    "configurePreset": "macos-arm64" },
    { "name": "android-arm64",  "configurePreset": "android-arm64" },
    { "name": "tests",          "configurePreset": "tests" }
  ]
}
